generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  name                  String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  password              String
  phone                 String?
  profileImage          String?
  role                  UserRole              @default(BUYER)
  resetToken            String?
  resetTokenExpiry      DateTime?
  aadhaarBackImage      String?
  aadhaarFrontImage     String?
  aadhaarNumber         String?
  aadhaarVerifiedAt     DateTime?
  aadhaarVerifiedBy     String?
  isAadhaarVerified     Boolean               @default(false)
  subscriptionEndDate   DateTime?
  subscriptionStartDate DateTime?
  subscriptionStatus    SubscriptionStatus    @default(ACTIVE)
  subscriptionTier      SubscriptionTier      @default(FREE)
  address               String?
  bio                   String?
  city                  String?
  country               String?               @default("India")
  pincode               String?
  state                 String?
  carsOwned             Car[]                 @relation("CarOwner")
  carsForSale           Car[]                 @relation("CarSeller")
  conversations1        Conversation[]        @relation("ConversationParticipant1")
  conversations2        Conversation[]        @relation("ConversationParticipant2")
  dealsAsBuyer          Deal[]                @relation("DealBuyer")
  dealsAsSeller         Deal[]                @relation("DealSeller")
  messagesSent          Message[]             @relation("MessageSender")
  purchases             Purchase[]            @relation("PurchaseBuyer")
  rentals               Rental[]              @relation("RentalBuyer")
  subscriptionPayments  SubscriptionPayment[]
}

model Car {
  id            String         @id @default(uuid())
  brand         String
  model         String
  year          Int
  color         String?
  mileage       Float?
  transmission  String?
  fuelType      String?
  seats         Int?
  rentalPrice   Float?
  salePrice     Float?
  isForRent     Boolean        @default(false)
  isForSale     Boolean        @default(false)
  status        CarStatus      @default(AVAILABLE)
  images        String[]
  primaryImage  String?
  description   String?
  ownerId       String?
  sellerId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  city          String?
  ownersCount   Int?
  owner         User?          @relation("CarOwner", fields: [ownerId], references: [id])
  seller        User?          @relation("CarSeller", fields: [sellerId], references: [id])
  conversations Conversation[]
  deals         Deal[]
  purchases     Purchase[]
  rentals       Rental[]

  @@index([ownerId])
  @@index([sellerId])
  @@index([status])
  @@index([isForRent, status])
  @@index([isForSale, status])
  @@index([isForRent, status, city])
  @@index([isForSale, status, city])
  @@index([brand])
  @@index([city])
  @@index([rentalPrice])
  @@index([salePrice])
}

model Rental {
  id                String        @id @default(uuid())
  carId             String
  buyerId           String
  startDate         DateTime
  endDate           DateTime
  totalDays         Int
  dailyPrice        Float
  totalAmount       Float
  razorpayOrderId   String?
  razorpayPaymentId String?
  paymentStatus     String        @default("PENDING")
  status            RentalStatus  @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  conversationId    String?       @unique
  deals             Deal[]
  buyer             User          @relation("RentalBuyer", fields: [buyerId], references: [id])
  car               Car           @relation(fields: [carId], references: [id])
  conversation      Conversation? @relation(fields: [conversationId], references: [id])

  @@index([buyerId])
  @@index([carId])
  @@index([conversationId])
}

model ShopLocation {
  id          String   @id @default(uuid())
  city        String
  addressLine String
  landmark    String?
  pincode     String?
  lat         Float?
  lng         Float?
  hoursStart  String   @default("09:00")
  hoursEnd    String   @default("19:00")
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
}

model Purchase {
  id                String         @id @default(uuid())
  carId             String
  buyerId           String
  salePrice         Float
  razorpayOrderId   String?
  razorpayPaymentId String?
  paymentStatus     String         @default("PENDING")
  status            PurchaseStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  conversationId    String?
  platformFee       Float?
  sellerEarnings    Float?
  deals             Deal[]
  buyer             User           @relation("PurchaseBuyer", fields: [buyerId], references: [id])
  car               Car            @relation(fields: [carId], references: [id])
  conversation      Conversation?  @relation(fields: [conversationId], references: [id])

  @@index([buyerId])
  @@index([carId])
  @@index([conversationId])
}

model Conversation {
  id             String     @id @default(uuid())
  participant1Id String
  participant2Id String
  carId          String?
  lastMessageAt  DateTime?
  lastMessage    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  car            Car?       @relation(fields: [carId], references: [id])
  participant1   User       @relation("ConversationParticipant1", fields: [participant1Id], references: [id])
  participant2   User       @relation("ConversationParticipant2", fields: [participant2Id], references: [id])
  deals          Deal[]
  messages       Message[]
  purchases      Purchase[]
  rental         Rental?

  @@unique([participant1Id, participant2Id, carId])
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([carId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  imageUrl       String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model PlatformFee {
  id            String   @id @default(uuid())
  feePercentage Float    @default(5.0)
  isActive      Boolean  @default(true)
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Deal {
  id             String       @id @default(uuid())
  conversationId String
  carId          String
  buyerId        String
  sellerId       String
  agreedPrice    Float
  dealType       String
  purchaseId     String?
  rentalId       String?
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  buyer          User         @relation("DealBuyer", fields: [buyerId], references: [id])
  car            Car          @relation(fields: [carId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  purchase       Purchase?    @relation(fields: [purchaseId], references: [id])
  rental         Rental?      @relation(fields: [rentalId], references: [id])
  seller         User         @relation("DealSeller", fields: [sellerId], references: [id])

  @@index([conversationId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([carId])
}

model SubscriptionPayment {
  id                String           @id @default(uuid())
  userId            String
  amount            Float
  tier              SubscriptionTier
  razorpayOrderId   String?
  razorpayPaymentId String?
  paymentStatus     String           @default("PENDING")
  startDate         DateTime
  endDate           DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
}

enum CarStatus {
  AVAILABLE
  RENTED
  SOLD
  MAINTENANCE
}

enum RentalStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SubscriptionTier {
  FREE
  BASIC
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}
